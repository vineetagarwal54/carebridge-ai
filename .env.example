# PostgreSQL / pgAdmin
POSTGRES_USER=carebridge_user
POSTGRES_PASSWORD=carebridge_pass
POSTGRES_DB=carebridge_db
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=your_email@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# Backend runtime
DATABASE_URL=postgresql+psycopg2://carebridge_user:carebridge_pass@localhost:5432/carebridge_db
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini / AI
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
